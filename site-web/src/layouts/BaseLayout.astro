---
// BaseLayout : gabarit de toutes les pages du site.
// Recoit en props un titre et une description, et expose <slot /> pour le contenu.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Conseil en infrastructure cloud, securite, CI/CD, IA et automatisation pour PME et ETI."
} = Astro.props;

const fullTitle = `${title} - Conseil`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph minimal pour partages sociaux -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />

    <!-- Sitemap : sera ajoute quand l'integration @astrojs/sitemap sera reactivee -->
  </head>

  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
