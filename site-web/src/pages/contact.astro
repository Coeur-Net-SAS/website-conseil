---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Décrivez votre besoin, nous revenons sous 48h avec une analyse synthétique.">

  <section class="border-b border-brand-700">
    <div class="container-page py-16">
      <h1 class="text-4xl sm:text-5xl font-bold">Discutons de votre projet</h1>
      <p class="mt-4 text-lg text-brand-300 max-w-2xl">
        Décrivez votre contexte en quelques lignes. Nous revenons avec une analyse synthétique
        et des pistes concrètes sous 48 heures ouvrées.
      </p>
    </div>
  </section>

  <section>
    <div class="container-prose py-12">

      <div id="form-success" class="hidden mb-6 rounded-md border border-green-700 bg-green-900/30 p-4 text-sm text-green-300">
        Message envoyé. Nous vous répondons sous 48 heures ouvrées.
      </div>
      <div id="form-error" class="hidden mb-6 rounded-md border border-red-700 bg-red-900/30 p-4 text-sm text-red-300">
        Une erreur est survenue. Veuillez réessayer ou nous contacter directement par email.
      </div>

      <form id="contact-form" class="space-y-5">

        <input type="hidden" name="access_key" value="5f48e5ca-8bcd-4375-b3fe-7a696884d0fb" />
        <input type="hidden" name="subject" value="Nouveau contact depuis le site" />
        <input type="hidden" name="from_name" value="Site Conseil" />
        <!-- Honeypot anti-spam -->
        <input type="checkbox" name="botcheck" class="hidden" aria-hidden="true" />

        <div>
          <label for="name" class="block text-sm font-medium text-brand-100">Nom et prénom</label>
          <input type="text" id="name" name="name" required
            class="mt-1 block w-full rounded-md border border-brand-700 px-3 py-2 shadow-sm focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-brand-100">Email professionnel</label>
          <input type="email" id="email" name="email" required
            class="mt-1 block w-full rounded-md border border-brand-700 px-3 py-2 shadow-sm focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
          />
        </div>

        <div>
          <label for="company" class="block text-sm font-medium text-brand-100">Entreprise <span class="text-brand-400 font-normal">(optionnel)</span></label>
          <input type="text" id="company" name="company"
            class="mt-1 block w-full rounded-md border border-brand-700 px-3 py-2 shadow-sm focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-brand-100">Votre besoin</label>
          <textarea id="message" name="message" rows="6" required
            class="mt-1 block w-full rounded-md border border-brand-700 px-3 py-2 shadow-sm focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
          ></textarea>
        </div>

        <div class="flex items-start gap-3">
          <input type="checkbox" id="consent" name="consent" required
            class="mt-1 h-4 w-4 rounded border-brand-300 text-accent-500 focus:ring-accent-500"
          />
          <label for="consent" class="text-sm text-brand-300">
            J'accepte que mes informations soient utilisées pour répondre à ma demande.
            Voir la <a href="/confidentialite" class="text-accent-500 hover:underline">politique de confidentialité</a>.
          </label>
        </div>

        <button type="submit" id="submit-btn" class="btn-primary">
          Envoyer le message
        </button>
      </form>
    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successEl = document.getElementById('form-success') as HTMLElement;
  const errorEl = document.getElementById('form-error') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Envoi en cours…';
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
      });
      const json = await res.json();
      if (json.success) {
        successEl.classList.remove('hidden');
        form.reset();
      } else {
        errorEl.classList.remove('hidden');
      }
    } catch {
      errorEl.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Envoyer le message';
    }
  });
</script>
