---
import BaseLayout from '../layouts/BaseLayout.astro';

// 5 expertises de modernisation = celles qui soutiennent la GRC
const modernizationDomains = [
  { title: 'Infrastructure cloud',          desc: 'Migration cloud souverain, environnements dev/staging/prod, outils internes auto-hébergés.',  image: '/images/expertise/04-cloud-infra.jpg',     imageAlt: 'Infrastructure cloud segmentee par environnement.' },
  { title: 'Sécurité & résilience',         desc: 'Plan de reprise d\'activité, scanners de vulnérabilités, threat modeling.',                    image: '/images/expertise/05-securite.jpg',        imageAlt: 'Chaine de protection : sauvegardes et scan de vulnerabilites.' },
  { title: 'CI/CD & GitOps',                desc: 'Pipelines de bout en bout, déploiement continu, Infrastructure as Code, Flux CD.',             image: '/images/expertise/06-cicd.jpg',            imageAlt: 'Pipeline CI/CD du commit au deploiement Kubernetes.' },
  { title: 'IA générative & automatisation', desc: 'Assistants de code locaux, transcription souveraine, workflows agentiques n8n.',              image: '/images/expertise/07-ia-generative.jpg',   imageAlt: 'Assistant IA souverain et workflows agentiques.' },
  { title: 'Administration système',        desc: 'GPO, jointure annuaire cloud, gestion fine des identités au quotidien.',                       image: '/images/expertise/08-administration.jpg',  imageAlt: 'Administration et integration aux annuaires cloud.' },
];

const stats = [
  { value: '2022',  label: 'année de fondation' },
  { value: '2',     label: 'sites en Centre-Val de Loire' },
  { value: '3',     label: 'référentiels visés (RGPD / ISO 27001 / ISO 42001)' },
  { value: '100%',  label: 'livrables documentés' },
];
---

<BaseLayout title="Accueil" description="Coeur-Net : conseil en gouvernance, conformite (GRC, RGPD, ISO 27001, ISO 42001) et modernisation IT, soutenu par une R&D propre en biometrie cardiaque.">

  <!-- ====================================================================
       HERO : GRC + modernisation, R&D mentionnee en sous-texte
       ==================================================================== -->
  <section class="border-b border-brand-700">
    <div class="container-page py-20 lg:py-28">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-wider text-accent-500 font-medium mb-4">
          Conseil &amp; conformité · Coeur-Net
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight">
          Conformité, gouvernance et modernisation IT.
        </h1>
        <p class="mt-6 text-lg text-brand-300 leading-relaxed max-w-2xl">
          Nous accompagnons les organisations sur leur mise en conformité
          <strong class="text-white">RGPD</strong>, <strong class="text-white">ISO 27001</strong>
          et <strong class="text-white">ISO 42001</strong>, et sur la modernisation de leur
          système d'information. Nous aidons aussi à activer les
          <strong class="text-white">solutions de financement public</strong> pour réduire le
          coût des projets.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn-primary">Discuter d'un besoin</a>
          <a href="/expertise" class="btn-secondary">Voir nos prestations</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       PETITE SECTION HISTOIRE : 3-4 phrases max
       ==================================================================== -->
  <section class="border-b border-brand-700 bg-brand-900/40">
    <div class="container-page py-12">
      <div class="grid lg:grid-cols-5 gap-8 items-start">
        <div class="lg:col-span-1">
          <p class="text-xs uppercase tracking-wider text-accent-500 font-semibold">
            Notre histoire
          </p>
        </div>
        <p class="lg:col-span-4 text-brand-200 leading-relaxed">
          Coeur-Net est née en <strong class="text-white">2022</strong> en
          <strong class="text-white">Centre-Val de Loire</strong>, fondée par une équipe
          d'experts pour développer la <strong class="text-white">recherche en biométrie
          cardiaque</strong> — l'authentification continue à partir du rythme du cœur.
          La rigueur acquise sur ces données sensibles (RGPD, fiabilité, traçabilité)
          constitue le socle de notre activité de conseil. Nous élargissons aujourd'hui
          cette expertise au plus grand nombre, autour de la <strong class="text-white">GRC</strong>
          et de la <strong class="text-white">modernisation IT</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       EXPERTISE VEDETTE : GRC en grand
       ==================================================================== -->
  <section class="border-b border-brand-700">
    <div class="container-page py-20">
      <div class="grid lg:grid-cols-5 gap-12 items-start">
        <div class="lg:col-span-2">
          <p class="text-sm uppercase tracking-wider text-accent-500 font-semibold">
            Notre cœur d'activité
          </p>
          <h2 class="mt-2 text-3xl sm:text-4xl font-bold">
            Gouvernance, risques &amp; conformité (GRC).
          </h2>
          <img
            src="/images/expertise/03-grc-conformite.jpg"
            alt="Cartographie des risques et plan de conformite RGPD, ISO 27001, ISO 42001."
            loading="lazy"
            decoding="async"
            width="1200"
            height="630"
            class="mt-6 w-full rounded-lg border border-brand-700 bg-brand-800/60 aspect-[16/9] object-cover"
          />
        </div>
        <div class="lg:col-span-3">
          <p class="text-brand-200 leading-relaxed">
            Mettre votre organisation aux normes par audit interne, gap analysis et plan de
            remédiation chiffré. Préparation aux référentiels les plus structurants du marché.
          </p>
          <ul class="mt-5 space-y-3 text-brand-200">
            <li class="pl-5 relative"><span class="absolute left-0 top-2.5 h-1.5 w-1.5 rounded-full bg-accent-500"></span><strong class="text-white">RGPD.</strong> Registre des traitements, AIPD, droits des personnes, DPO.</li>
            <li class="pl-5 relative"><span class="absolute left-0 top-2.5 h-1.5 w-1.5 rounded-full bg-accent-500"></span><strong class="text-white">ISO/IEC 27001.</strong> Système de management de la sécurité, Annexe A.</li>
            <li class="pl-5 relative"><span class="absolute left-0 top-2.5 h-1.5 w-1.5 rounded-full bg-accent-500"></span><strong class="text-white">ISO/IEC 42001.</strong> Système de management de l'IA.</li>
            <li class="pl-5 relative"><span class="absolute left-0 top-2.5 h-1.5 w-1.5 rounded-full bg-accent-500"></span><strong class="text-white">Audit interne.</strong> Cartographie des risques, plan de remédiation chiffré.</li>
            <li class="pl-5 relative"><span class="absolute left-0 top-2.5 h-1.5 w-1.5 rounded-full bg-accent-500"></span><strong class="text-white">Politique de sécurité.</strong> Classification des données, plan de continuité.</li>
          </ul>
          <a href="/expertise#grc" class="mt-6 inline-flex text-accent-500 font-medium hover:underline">
            Voir le détail de l'expertise GRC →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       FINANCEMENT PUBLIC : CTA dedie
       ==================================================================== -->
  <section class="border-b border-brand-700 bg-gradient-to-r from-brand-900/40 to-accent-500/10">
    <div class="container-page py-16">
      <div class="grid lg:grid-cols-3 gap-8 items-center">
        <div class="lg:col-span-2">
          <p class="text-xs uppercase tracking-wider text-accent-500 font-semibold">
            Vos projets, subventionnés
          </p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-bold">
            Nous activons les dispositifs de financement public pour vous.
          </h2>
          <p class="mt-3 text-brand-200 leading-relaxed">
            Identification des aides éligibles, montage des dossiers, suivi des engagements :
            nous aidons nos clients à activer les bons dispositifs pour réduire le coût de
            leurs projets.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="text-xs font-mono px-2 py-1 rounded bg-brand-900 text-brand-200 border border-brand-700">CIR</span>
            <span class="text-xs font-mono px-2 py-1 rounded bg-brand-900 text-brand-200 border border-brand-700">CII</span>
            <span class="text-xs font-mono px-2 py-1 rounded bg-brand-900 text-brand-200 border border-brand-700">BPI France</span>
            <span class="text-xs font-mono px-2 py-1 rounded bg-brand-900 text-brand-200 border border-brand-700">France 2030</span>
            <span class="text-xs font-mono px-2 py-1 rounded bg-brand-900 text-brand-200 border border-brand-700">FEDER</span>
            <span class="text-xs font-mono px-2 py-1 rounded bg-brand-900 text-brand-200 border border-brand-700">Région Centre-Val de Loire</span>
          </div>
        </div>
        <div class="lg:col-span-1 lg:text-right">
          <a href="/expertise#financement" class="btn-primary">Découvrir le dispositif</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       CHIFFRES
       ==================================================================== -->
  <section class="bg-brand-900/40 border-b border-brand-700">
    <div class="container-page py-12">
      <dl class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        {stats.map(({ value, label }) => (
          <div>
            <dt class="text-3xl sm:text-4xl font-bold text-white">{value}</dt>
            <dd class="mt-1 text-sm text-brand-300">{label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ====================================================================
       EXPERTISES DE MODERNISATION : 5 cartes en soutien de la GRC
       ==================================================================== -->
  <section class="border-b border-brand-700">
    <div class="container-page py-20">
      <div class="max-w-2xl">
        <p class="text-sm uppercase tracking-wider text-brand-400 font-semibold">
          Pour soutenir la GRC
        </p>
        <h2 class="mt-2 text-2xl sm:text-3xl font-bold">
          Cinq expertises de modernisation IT.
        </h2>
        <p class="mt-3 text-brand-300">
          Une conformité ne s'écrit pas sur le papier : elle se mesure dans l'infrastructure,
          les pipelines, la gestion des accès. Ces cinq domaines complètent notre offre GRC.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {modernizationDomains.map(({ title, desc, image, imageAlt }) => (
          <article class="rounded-lg border border-brand-700 bg-brand-900 overflow-hidden hover:border-accent-500 transition flex flex-col">
            <img
              src={image}
              alt={imageAlt}
              loading="lazy"
              decoding="async"
              width="1200"
              height="630"
              class="w-full aspect-[16/9] object-cover bg-brand-800/60"
            />
            <div class="p-4 flex flex-col flex-1">
              <h3 class="text-sm font-semibold leading-snug">{title}</h3>
              <p class="mt-2 text-xs text-brand-300 leading-relaxed">{desc}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-10">
        <a href="/expertise" class="text-accent-500 font-medium hover:underline">
          Voir le détail de toutes les expertises →
        </a>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       R&D HERITAGE : mention discrete
       ==================================================================== -->
  <section class="border-b border-brand-700">
    <div class="container-page py-12">
      <p class="text-xs uppercase tracking-wider text-brand-400 font-semibold">
        Notre R&amp;D propre
      </p>
      <p class="mt-2 text-brand-300 max-w-3xl leading-relaxed">
        Coeur-Net continue ses travaux de recherche en
        <strong class="text-white">biométrie cardiaque</strong> et en
        <strong class="text-white">authentification continue</strong>. Ces recherches alimentent
        directement notre conseil : elles nous donnent une compréhension fine des données
        sensibles, des biais des modèles d'IA et des exigences de conformité associées —
        autant de leviers qui profitent à nos clients en mission.
      </p>
    </div>
  </section>

  <!-- ====================================================================
       CTA FINAL
       ==================================================================== -->
  <section class="bg-brand-900">
    <div class="container-page py-16 text-center">
      <h2 class="text-3xl font-bold text-white">Un projet en tête ?</h2>
      <p class="mt-3 text-brand-300 max-w-xl mx-auto">
        Décrivez-nous votre contexte. Nous revenons avec une analyse synthétique
        et des pistes concrètes — y compris sur les financements mobilisables — sous 48 heures.
      </p>
      <a href="/contact" class="mt-6 inline-flex btn-primary">
        Prendre contact
      </a>
    </div>
  </section>

</BaseLayout>
