---
import NewsletterForm from './NewsletterForm.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-700 bg-brand-900/40 mt-16">
  <div class="container-page py-10">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2 text-white font-semibold">
          <span class="inline-block h-6 w-6 rounded bg-accent-500 text-white text-center leading-6 text-xs">C</span>
          <span>Conseil</span>
        </div>
        <p class="mt-3 text-sm text-brand-300 leading-relaxed">
          Recherche IA, identité biométrique, GRC. Cloud, sécurité, CI/CD pour la mise en œuvre.
        </p>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-brand-400">Navigation</h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/expertise" class="text-brand-300 hover:text-accent-500">Expertise</a></li>
          <li><a href="/realisations" class="text-brand-300 hover:text-accent-500">Réalisations</a></li>
          <li><a href="/blog" class="text-brand-300 hover:text-accent-500">Blog</a></li>
          <li><a href="/a-propos" class="text-brand-300 hover:text-accent-500">À propos</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-brand-400">Légal</h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/mentions-legales" class="text-brand-300 hover:text-accent-500">Mentions légales</a></li>
          <li><a href="/confidentialite" class="text-brand-300 hover:text-accent-500">Confidentialité</a></li>
          <li><a href="/contact" class="text-brand-300 hover:text-accent-500">Contact</a></li>
        </ul>
      </div>

      <div>
        <NewsletterForm compact />
      </div>
    </div>

    <div class="mt-10 border-t border-brand-700 pt-6 text-xs text-brand-400">
      © {year} — Tous droits réservés.
    </div>
  </div>
</footer>
